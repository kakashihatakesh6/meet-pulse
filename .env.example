# =============================================================================
# MEETING PULSE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Note: In accordance with Google Security Best Practices for Mobile Apps,
# NEVER include Google Client Secrets in client-side mobile applications.
# All requests utilize OAuth 2.0 PKCE Authorization Code flow.
# =============================================================================

# Google Cloud Console OAuth 2.0 Client IDs
# Obtain these from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_universal_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your_web_client_id.apps.googleusercontent.com

# OAuth Redirect Scheme / URI
# For Expo Go / Development: https://auth.expo.io/@your-expo-username/meetpulse
# For Standalone / Production: meetpulse://redirect
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=meetpulse://redirect

# Application Defaults
EXPO_PUBLIC_DEFAULT_REMINDER_MINUTES=15
EXPO_PUBLIC_SYNC_INTERVAL_MINUTES=15
EXPO_PUBLIC_APP_ENV=development
